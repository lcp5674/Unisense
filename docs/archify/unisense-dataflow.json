  "cards": [
    {
      "dot": "emerald",
      "title": "主数据路径",
      "items": [
        "源 → 采集 → 资产目录/血缘 → 语义 → 消费，自左向右逐级命名",
        "每条流带标签：数据资产（表结构 / ETL SQL / 事件）与动作",
        "口径读取回到指标真相源，指标版本 vN 全程可追溯"
      ]
    },
    {
      "dot": "rose",
      "title": "数据分类边界",
      "items": [
        "采集即打码：样本以脱敏形态连同敏感分类写入资产目录（security 流）",
        "消费服务以分类做 PII 四级门禁，敏感资产不落下游普通报表",
        "注册含 PII 指标时经 governance 合规复核（FORBIDDEN_PII 拦截）"
      ]
    },
    {
      "dot": "orange",
      "title": "流批与下游",
      "items": [
        "批路径（业务 MySQL / Hive 周期拉取）与流式路径（Kafka 实时事件）分道",
        "ETL SQL 独立解析入库 Neo4j 血缘图，语义层引用血缘做变更影响分析",
        "下游 QuickBI / DataAgent / 前端经消费服务统一受控取数"
      ]
    }
  ]
