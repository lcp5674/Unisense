# Unisense 环境变量模板（对齐 DEV_GUIDE §12.2/§12.4）
# 复制为 .env 并填写实际值（.env 已加入 .gitignore，禁止提交明文密钥）
# 命名规范：所有应用配置变量用 UNISENSE_ 前缀（pydantic-settings env_prefix=UNISENSE_）

# ---- 环境标识（必填）----
UNISENSE_ENV=local

# ---- MySQL ----
# 注意：docker-compose.yml 中 MySQL 宿主机端口已偏移为 3307（避免与本机其它 MySQL 冲突）
UNISENSE_DB_URL=mysql+pymysql://unisense:PASSWORD@localhost:3307/unisense
# Docker 服务用（docker-compose.yml 读取，非应用配置）
UNISENSE_MYSQL_ROOT_PASSWORD=
UNISENSE_MYSQL_DATABASE=unisense
UNISENSE_MYSQL_USER=unisense
UNISENSE_MYSQL_PASSWORD=

# ---- Neo4j ----
UNISENSE_NEO4J_URL=bolt://localhost:7687
UNISENSE_NEO4J_USER=neo4j
UNISENSE_NEO4J_PASSWORD=

# ---- Elasticsearch ----
# 注意：docker-compose.yml 中 ES 宿主机端口已偏移为 19200（避免与本机已运行 ES 的 9200 冲突）
UNISENSE_ES_URL=http://localhost:19200
UNISENSE_ES_USER=elastic
UNISENSE_ES_PASSWORD=

# ---- Redis ----
# 注意：docker-compose.yml 中 Redis 宿主机端口已偏移为 16379（避免与本机已运行 Redis 的 6379 冲突）
UNISENSE_REDIS_URL=redis://localhost:16379/0
UNISENSE_REDIS_PASSWORD=

# ---- OLAP (Doris/StarRocks) ----
# 注意：config.py 字段名为 olap_url（非 olap_dsn），留空则 consume 查询降级 503
UNISENSE_OLAP_URL=

# ---- OpenTelemetry ----
UNISENSE_OTLP_ENDPOINT=http://localhost:4317

# ---- JWT ----
UNISENSE_JWT_SECRET=
UNISENSE_JWT_ALGORITHM=HS256
UNISENSE_JWT_EXPIRE_MINUTES=60

# ---- KMS ----
UNISENSE_KMS_KEY_ID=

# ---- LLM ----
UNISENSE_LLM_DEFAULT_MODEL=deepseek-chat
UNISENSE_LLM_API_KEY=
UNISENSE_LLM_BASE_URL=

# 测试环境示例（kilo.ai 网关，OpenAI 协议兼容）：
# UNISENSE_LLM_BASE_URL=https://api.kilo.ai/api/gateway
# UNISENSE_LLM_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# UNISENSE_LLM_DEFAULT_MODEL=poolside/laguna-m.1:free

# 国内主流大模型示例（均走 OpenAI 兼容协议）：
# DeepSeek:    UNISENSE_LLM_BASE_URL=https://api.deepseek.com,            MODEL=deepseek-chat
# 通义千问:    UNISENSE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode, MODEL=qwen-turbo
# 文心一言:    UNISENSE_LLM_BASE_URL=https://aip.baidubce.com/rpc/2.0/ai_custom, MODEL=ernie-bot-turbo

# ---- 通知渠道 ----
# Webhook 投递地址（留空则仅入库不外发）
UNISENSE_NOTIFY_WEBHOOK_URL=

# ---- Fernet 加密密钥（独立于 JWT 密钥）----
# 生产环境必须通过 Secret Manager 注入 32 字节密钥
UNISENSE_FERNET_KEY=

# ---- CORS ----
UNISENSE_CORS_ORIGINS=http://localhost:3000

# ---- 日志 ----
UNISENSE_LOG_LEVEL=INFO
UNISENSE_LOG_FORMAT=json

# ---- 配置覆盖（参见 TD §13 完整参数清单，此处仅列最常用的）----
# UNISENSE_METRIC_VERSION_SUNSET_DAYS=30
# UNISENSE_API_CLIENT_QPS_LIMIT=20
# UNISENSE_PII_RESCAN_INTERVAL_DAYS=7
