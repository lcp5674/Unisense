# =============================================================================
# Unisense 生产环境配置模板（.env.production.example）
# -----------------------------------------------------------------------------
# 用法（生产部署）：
#   1. 复制模板：   cp .env.production.example .env.production
#   2. 填充强密钥： bash scripts/gen_prod_secrets.sh --out .env.production
#      （脚本检测到模板占位 <generated-by-script> 即【就地填充】11 项密钥行，
#        非密钥配置行与注释全部保留；填充后文件已是真实密钥文件，再跑会拒绝覆盖）
#   3. 按实际环境修改下方「Doris/OLAP」与「可观测/通知」等非密钥项
#   4. 启动：       docker compose --env-file .env.production up -d
#   5. 验证：       docker compose --env-file .env.production ps
#
# ⚠️ 生产校验（backend 启动时强制，违反即拒绝启动）：
#   - env 非 local/dev/test 即触发（staging/production 均视为生产）
#   - JWT_SECRET ≥32 字符且非弱值；FERNET_KEY 必须独立配置
#   - ES/MinIO/Neo4j 密码与 MySQL db_url 不得命中弱凭据黑名单
#   - OLAP_URL 必须非空（Doris 冲突，见下方说明）
# ⚠️ 本文件含敏感占位符，禁止提交入库（已在 .gitignore）；首次部署用全新数据卷
#   初始化（改 .env 不会更新已运行数据卷内固化的 MySQL/ES/Neo4j 密码）。
# =============================================================================

# ---------------------------------------------------------------------------
# 环境与镜像
# ---------------------------------------------------------------------------
# 生产环境标识：local/dev/test 之外一律触发生产强校验
UNISENSE_ENV=prod
# 部署的镜像 tag（建议用日期/提交号锁定，便于回滚）
UNISENSE_IMAGE_TAG=dev
# Python 包镜像源（构建 backend/worker 镜像时 pip 使用）：
# 默认清华源，国内构建快、避免官方 PyPI 网络超时；如公司有内网源可改
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 日志级别与格式
UNISENSE_LOG_LEVEL=info
UNISENSE_LOG_FORMAT=json
# CORS 白名单（逗号分隔的完整 Origin，生产禁止 *）
UNISENSE_CORS_ORIGINS=https://your-domain.example.com

# ---------------------------------------------------------------------------
# 安全密钥（以下 11 项由 gen_prod_secrets.sh 生成，勿手写弱值）
# ⚠️ 本文件是生产的「密钥锚点」：只生成一次、长期不变（脚本对已存在的真实密钥文件
#    默认拒绝覆盖，需 --force 才覆盖）。重建容器会从本文件读取同一组密钥；重复生成
#    会换掉全部密钥导致 JWT 会话全失效、已加密的数据源/LLM 凭据无法解密、
#    DB/ES/Neo4j 密码与数据卷不一致而崩溃。
# ---------------------------------------------------------------------------
# JWT 签名密钥（≥32 字符，生产强校验）
UNISENSE_JWT_SECRET=<generated-by-script>
# 凭据加密主密钥（独立于 JWT_SECRET，生产强校验；轮换走 key_rotation 密钥链）
UNISENSE_FERNET_KEY=<generated-by-script>
# MySQL root 密码（仅首次初始化卷时生效）
UNISENSE_MYSQL_ROOT_PASSWORD=<generated-by-script>
# MySQL 业务账号密码（与 UNISENSE_DB_URL 联动；首次初始化卷时生效）
UNISENSE_MYSQL_PASSWORD=<generated-by-script>
# Elasticsearch elastic 用户密码（首次初始化卷时生效）
UNISENSE_ES_PASSWORD=<generated-by-script>
# Neo4j 密码（compose 默认 test1234 命中生产弱凭据黑名单，必须由脚本填充）
UNISENSE_NEO4J_PASSWORD=<generated-by-script>
# MinIO root 凭据（首次初始化卷时生效）
UNISENSE_MINIO_ACCESS_KEY=<generated-by-script>
UNISENSE_MINIO_SECRET_KEY=<generated-by-script>
# 种子管理员初始密码（首次 bootstrap 时创建 admin 使用；上线后立即改密）
UNISENSE_SEED_ADMIN_PASSWORD=<generated-by-script>
# 备份加密密钥（backup.sh 对 mysqldump 产物做 AES-256 加密）
UNISENSE_BACKUP_ENCRYPTION_KEY=<generated-by-script>
# QuickBI 嵌入票据签名密钥（未配置则 ticket 接口 503 降级，可留待需要时）
UNISENSE_QUICKBI_SIGN_KEY=<generated-by-script>

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# 库名与业务账号（UNISENSE_DB_URL 由 compose 按 用户:密码@mysql:3306/库 自动构造）
UNISENSE_MYSQL_DATABASE=unisense
UNISENSE_MYSQL_USER=unisense
# 生产强校验：db_url 不得含 :test@ / :test:
# 连接池/性能（可选覆盖 compose 默认）
# UNISENSE_MYSQL_BUFFER_POOL=4G
# UNISENSE_MYSQL_MEM=5g
# UNISENSE_MYSQL_CPUS=2
# consume 查询的 MySQL 只读降级引擎（OLAP 不可用时自动降级，可留默认）
# UNISENSE_MYSQL_FALLBACK_URL=mysql+aiomysql://e2e:e2e@mysql:3306/e2e_biz?charset=utf8mb4

# ---------------------------------------------------------------------------
# Elasticsearch（全局搜索）
# ---------------------------------------------------------------------------
# UNISENSE_ES_URL=http://elasticsearch:9200
UNISENSE_ES_USERNAME=elastic
# 堆内存与资源（生产建议 2g 起步，随数据量上调）
UNISENSE_ES_HEAP=2g
# UNISENSE_ES_MEM=4g
# UNISENSE_ES_CPUS=1.5

# ---------------------------------------------------------------------------
# Neo4j（资产血缘图谱）
# ---------------------------------------------------------------------------
# 密码由上方密钥区 UNISENSE_NEO4J_PASSWORD 生成（compose 默认 test1234 命中生产
# 弱凭据黑名单，backend 会拒绝启动——务必由脚本填充，勿留默认）
UNISENSE_NEO4J_URL=bolt://neo4j:7687
UNISENSE_NEO4J_USER=neo4j
# UNISENSE_NEO4J_MEM=2g
# UNISENSE_NEO4J_CPUS=1

# ---------------------------------------------------------------------------
# Redis（任务队列 / SSE pub-sub / 熔断器）
# ---------------------------------------------------------------------------
# UNISENSE_REDIS_URL=redis://:redispass@redis:6379/0
# UNISENSE_REDIS_MEM=1g
# UNISENSE_REDIS_CPUS=0.5

# ---------------------------------------------------------------------------
# MinIO（审计日志冷归档）
# ---------------------------------------------------------------------------
UNISENSE_MINIO_ENDPOINT=minio:9000
UNISENSE_MINIO_BUCKET=unisense-archive
# UNISENSE_MINIO_MEM=0.5g
# UNISENSE_MINIO_CPUS=0.25

# ---------------------------------------------------------------------------
# Bootstrap（首次启动初始化）
# ---------------------------------------------------------------------------
# 首次部署置 true；后续启动建议置 false 避免重复执行
UNISENSE_BOOTSTRAP_ENABLED=true
# 初始化步骤：admin 种子账号 / 主题域 / ES 索引 / Neo4j
UNISENSE_BOOTSTRAP_STEPS=admin,domains,es,neo4j
UNISENSE_BOOTSTRAP_ES_SYNC=true
# UNISENSE_BOOTSTRAP_TIMEOUT=120
# UNISENSE_BOOTSTRAP_LOCK_WAIT=20
# UNISENSE_BOOTSTRAP_ES_SYNC_MAX_DOCS=50000

# ---------------------------------------------------------------------------
# LLM（外部推理网关，本地无需 GPU；多实例在系统配置中维护，路由自动 failover）
# ---------------------------------------------------------------------------
# UNISENSE_LLM_BASE_URL=
# UNISENSE_LLM_API_KEY=
# UNISENSE_LLM_DEFAULT_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Doris / OLAP（consume 指标查询执行引擎）
# ---------------------------------------------------------------------------
# ⚠️ 生产强校验：UNISENSE_OLAP_URL 必须非空，否则 backend 拒绝启动。
#   若暂不启用 Doris 消费，请选择其一：
#   a) 配置你已有的外部 Doris/StarRocks FE：
UNISENSE_OLAP_URL=http://your-doris-fe:8030/unisense
UNISENSE_DORIS_HOST=your-doris-fe
UNISENSE_DORIS_PORT=8030
UNISENSE_DORIS_DATABASE=unisense
#   b) 或保持 UNISENSE_ENV 非 prod（local/dev），放弃生产强校验（不推荐生产）。

# ---------------------------------------------------------------------------
# 采集器（内网数据源访问）
# ---------------------------------------------------------------------------
# 是否允许采集器访问内网/回环地址（生产默认 false，严格 SSRF 防护）
UNISENSE_COLLECTOR_ALLOW_PRIVATE=false

# ---------------------------------------------------------------------------
# 通知（可选：业务事件 Webhook 回调）
# ---------------------------------------------------------------------------
# UNISENSE_NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# 组件资源配额（8 核 / 32G 参考基线，按实际机器调整）
# ---------------------------------------------------------------------------
UNISENSE_BACKEND_MEM=5g
UNISENSE_BACKEND_CPUS=2
UNISENSE_WORKER_MEM=6g
UNISENSE_WORKER_CPUS=3
UNISENSE_FRONTEND_MEM=0.5g
UNISENSE_FRONTEND_CPUS=0.25
UNISENSE_BACKUP_MEM=0.5g
UNISENSE_BACKUP_CPUS=0.25
UNISENSE_BINLOG_MEM=0.5g
UNISENSE_BINLOG_CPUS=0.25
